# NAME: DeshiCode DcamX (T23N, GC2083, TXW901)
# FRAG: soc-xburst1 core
BR2_PACKAGE_THINGINO_KOPT_MMC0=y
BR2_PACKAGE_THINGINO_KOPT_MMC0_PB_4BIT=y
BR2_PACKAGE_WIFI=y
BR2_PACKAGE_WIFI_TXW901U=y
BR2_SENSOR_1_NAME="gc2083"
BR2_INGENIC_SOC_MODEL="t23n"
FLASH_SIZE_MB=16


# AUDIO
# Speaker amp enable GPIO is set via gpio.speaker in thingino.json, not a
# Kconfig option.
BR2_THINGINO_AUDIO=y


# LED
BR2_THINGINO_LED_W_GPIO=17
BR2_THINGINO_LED_B_GPIO=16

# Button
# Reset button GPIO is set via gpio.button_reset in thingino.json, not a
# Kconfig option.
BR2_THINGINO_BUTTON=y

# SD Card
# Card-detect GPIO is set via gpio.mmc_cd in thingino.json, not a Kconfig
# option.
BR2_THINGINO_SDCARD=y

# Pan/Tilt Motors
# GPIO pins/order are set via motors.gpio_pan/gpio_tilt in thingino.json, not
# a Kconfig option. steps_pan/steps_tilt/speed_* in thingino.json are still
# placeholder defaults - not yet calibrated against this unit's actual
# mechanical travel range.
BR2_THINGINO_MOTORS=y
BR2_THINGINO_MOTORS_TCU=y

# Raptor streamer - live viewing only (RTSP + WebRTC). RAPTOR_FULL builds
# every daemon by default (recording, motion detection, RTMP push, USB
# webcam, WebTorrent) whether used or not, competing with RVD/RWD for CPU
# on every real-time encode. Trimmed to just what's actually used; RIC stays
# on since it's the day/night IR-CUT controller, unrelated to streaming.
# BR2_PACKAGE_THINGINO_RAPTOR_FULL=n
# BR2_PACKAGE_THINGINO_RAPTOR_RVD=y
# BR2_PACKAGE_THINGINO_RAPTOR_RSD=y
# BR2_PACKAGE_THINGINO_RAPTOR_RAD=y
# BR2_PACKAGE_THINGINO_RAPTOR_ROD=y
# BR2_PACKAGE_THINGINO_RAPTOR_RIC=y
# BR2_PACKAGE_THINGINO_RAPTOR_WEBRTC=y


